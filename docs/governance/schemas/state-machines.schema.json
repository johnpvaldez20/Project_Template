{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governance/schemas/state-machines.schema.json",
  "title": "StateMachineCatalog",
  "description": "The state machines that architecture.state_machines names. A packet cites a machine by its entity name. That packet lists one test for each transition and one test for each forbidden transition.",
  "type": "object",
  "required": ["machines"],
  "additionalProperties": false,
  "properties": {
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/machine" }
    }
  },
  "$defs": {
    "machine": {
      "type": "object",
      "required": ["entity", "linear", "initial", "states", "transitions"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SM-[0-9]{2,}$",
          "description": "Optional catalog id. It must be unique."
        },
        "title": { "type": "string", "minLength": 1 },
        "entity": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "description": "The name that a packet cites in state_machines."
        },
        "linear": {
          "type": "boolean",
          "description": "True when each state moves only to the next state in the list."
        },
        "initial": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        },
        "forbidden_transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/forbidden_transition" },
          "description": "Moves that the machine must reject. Each one names the test that proves the rejection."
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "test"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1, "description": "What starts the move." },
        "guard": { "type": "string", "minLength": 1, "description": "The condition that must be true." },
        "test": { "$ref": "#/$defs/test_name" }
      }
    },
    "forbidden_transition": {
      "type": "object",
      "required": ["from", "to", "test"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "test": { "$ref": "#/$defs/test_name" }
      }
    },
    "test_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.:][A-Za-z_][A-Za-z0-9_]*)*$"
    }
  }
}
